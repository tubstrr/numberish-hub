# Production environment for numberish-hub on the NAS.
#
# Copy to `.env` in this directory and fill in a real password. That file is
# gitignored and must never be committed — unlike the dev-only etc/docker/.env,
# these credentials are real.
#
# Generate a password on the NAS (openssl is NOT installed on ZimaOS):
#   head -c 32 /dev/urandom | base64
#
# This role and database are created once in the shared `postgresql`
# container — see docs/DEPLOY-NAS.md.

DB_USER=numberish_user
DB_PASSWORD=replace-me
DB_DATABASE=numberish
